# Local development only. DEMO uses validated fixtures, not PostgreSQL.
TRAVELWISE_DATA_SOURCE=demo
# Compose fallback only; the Windows service setup uses the two URLs below.
POSTGRES_USER=travelwise_dev
POSTGRES_PASSWORD=
POSTGRES_DB=travelwise_dev
POSTGRES_PORT=5432
POSTGRES_TEST_USER=travelwise_test
POSTGRES_TEST_PASSWORD=
# For PostgreSQL mode, use the dedicated non-superuser roles created during setup.
# Keep passwords URL-encoded and never commit .env.
DATABASE_URL=postgresql://travelwise_dev:<password>@127.0.0.1:5432/travelwise_dev
TEST_DATABASE_URL=postgresql://travelwise_test:<password>@127.0.0.1:5432/travelwise_test
# Admin backend. Generate a hash using hidden input + npm run admin:hash -- --stdin (see README).
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Optional V1.1-B server-side provider. Never expose this to browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
