# Release preparation only. Copy outside Git; Owner authorization is required to deploy.
NODE_ENV=production
TRAVELWISE_DATA_SOURCE=postgres
DATABASE_URL=
# DEMO fixtures and seeds are forbidden in production.
AUTH_SECRET=
# Canonical HTTPS URL; proxy must overwrite Host/X-Forwarded-* from untrusted clients.
AUTH_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Standalone server only; use an unused loopback port confirmed on the target host.
HOSTNAME=127.0.0.1
PORT=3210
