{
  "name": "travelwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:db": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:install": "node scripts/install-browser.mjs",
    "test:e2e:db": "node --env-file-if-exists=.env ./node_modules/@playwright/test/cli.js test --config playwright.db.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run db:check",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:init": "node --env-file-if-exists=.env --import tsx scripts/init-reference-data.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "admin:hash": "node --import tsx scripts/hash-password.ts",
    "radar:run": "node --env-file-if-exists=.env --import tsx scripts/radar-runner.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.53.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
